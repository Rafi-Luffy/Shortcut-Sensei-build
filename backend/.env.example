
# Supabase Postgres
SUPABASE_CONNECTION_STRING=

# JWT (used by legacy local auth routes)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Clerk (required for /api/auth/clerk/*)
CLERK_SECRET_KEY=

# Supabase (required for all backend data reads/writes)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
SUPABASE_CONNECTION_STRING=

