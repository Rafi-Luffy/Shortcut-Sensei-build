# Render Deployment Environment Variables
# Copy these to your Render dashboard environment variables section

# Database Configuration
SUPABASE_CONNECTION_STRING=supabase+srv://username:password@cluster.supabase.net/shortcut_sensei?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_here_minimum_32_characters

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Application Configuration
NODE_ENV=production
PORT=10000

# API Configuration
API_BASE_URL=https://your-render-app-name.onrender.com

# Security (Optional - Render generates these automatically)
# JWT_SECRET will be auto-generated by Render if not set

# Database Connection (Supabase Postgres Atlas recommended)
# 1. Create account at https://cloud.supabase.com
# 2. Create a cluster
# 3. Create database user
# 4. Get connection string
# 5. Whitelist Render's IP addresses (0.0.0.0/0 for development)

# Email Setup (Gmail)
# 1. Enable 2-factor authentication on Gmail
# 2. Generate App Password: https://support.google.com/accounts/answer/185833
# 3. Use the App Password (not your regular password) for EMAIL_PASS

# Render Specific
# These are automatically set by Render:
# RENDER_EXTERNAL_URL
# RENDER_GIT_BRANCH
# RENDER_GIT_COMMIT
# RENDER_GIT_REPO_SLUG
# RENDER_SERVICE_ID
# RENDER_SERVICE_NAME